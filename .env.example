# ── PostgreSQL / pgvector (Docker container) ──────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_USER=rag_user
PG_PASSWORD=rag_password
PG_DATABASE=rag_db

# ── Neo4j Desktop ─────────────────────────────────────────────────────────────
# Open Neo4j Desktop, start your DBMS, then set the password below.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── LLM provider: "ollama" | "anthropic" | "openai" ──────────────────────────
LLM_PROVIDER=ollama

# ── Anthropic (optional — leave blank if using Ollama) ────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── OpenAI (optional — leave blank if using Ollama) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama is always tried first for answer generation. Enable one cloud fallback if desired.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=anthropic

# ── Ollama (local dev defaults) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_WORDS=180
CHUNK_OVERLAP=35

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
ROUTE_CONFIDENCE_THRESHOLD=0.65
# nomic-embed-text produces 768-dim vectors
# If you switch to a different model, update this and re-ingest all documents
EMBEDDING_DIM=768
